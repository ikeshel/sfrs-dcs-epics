<?xml version="1.0" encoding="UTF-8"?>
<databrowser>
  <show_toolbar>false</show_toolbar>
  <show_legend>true</show_legend>
  <grid>true</grid>
  <update_period>1.0</update_period>
  <scroll_step>1</scroll_step>
  <scroll>true</scroll>
  <start>-5 minutes</start>
  <end>now</end>
  <archive_rescale>NONE</archive_rescale>
  <axes>
    <axis>
      <visible>true</visible>
      <name>Temperature (°C)</name>
      <use_axis_name>true</use_axis_name>
      <use_trace_names>false</use_trace_names>
      <min>10.0</min>
      <max>50.0</max>
      <grid>true</grid>
      <autoscale>false</autoscale>
    </axis>
  </axes>
  <pvlist>
    <pv>
      <display_name>ROW0</display_name>
      <name>jackie://SFRS:FPF2:POWERPI01:PT1000:ROW0:TEMPERATURE</name>
      <axis>0</axis>
      <color>
        <red>29</red>
        <green>102</green>
        <blue>178</blue>
      </color>
      <trace_type>SINGLE_LINE_DIRECT</trace_type>
      <line_style>SOLID</line_style>
      <linewidth>2</linewidth>
    </pv>
    <pv>
      <display_name>ROW1</display_name>
      <name>jackie://SFRS:FPF2:POWERPI01:PT1000:ROW1:TEMPERATURE</name>
      <axis>0</axis>
      <color>
        <red>177</red>
        <green>79</green>
        <blue>18</blue>
      </color>
      <trace_type>SINGLE_LINE_DIRECT</trace_type>
      <line_style>DASH</line_style>
      <linewidth>2</linewidth>
    </pv>
    <pv>
      <display_name>ROW2</display_name>
      <name>jackie://SFRS:FPF2:POWERPI01:PT1000:ROW2:TEMPERATURE</name>
      <axis>0</axis>
      <color>
        <red>0</red>
        <green>122</green>
        <blue>105</blue>
      </color>
      <trace_type>SINGLE_LINE_DIRECT</trace_type>
      <line_style>DOT</line_style>
      <linewidth>2</linewidth>
    </pv>
    <pv>
      <display_name>ROW3</display_name>
      <name>jackie://SFRS:FPF2:POWERPI01:PT1000:ROW3:TEMPERATURE</name>
      <axis>0</axis>
      <color>
        <red>122</red>
        <green>63</green>
        <blue>158</blue>
      </color>
      <trace_type>SINGLE_LINE_DIRECT</trace_type>
      <line_style>DASHDOT</line_style>
      <linewidth>2</linewidth>
    </pv>
    <pv>
      <display_name>BME280</display_name>
      <name>jackie://SFRS:FPF2:POWERPI01:BME280:TEMPERATURE</name>
      <axis>0</axis>
      <color>
        <red>45</red>
        <green>54</green>
        <blue>63</blue>
      </color>
      <trace_type>SINGLE_LINE_DIRECT</trace_type>
      <line_style>SOLID</line_style>
      <linewidth>2</linewidth>
    </pv>
  </pvlist>
</databrowser>
