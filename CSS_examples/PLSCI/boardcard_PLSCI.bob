<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <width>300</width>
  <height>331</height>
  <grid_visible>false</grid_visible>
  <widget type="group" version="3.0.0">
    <name>Board</name>
    <height>331</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="rectangle" version="2.0.0">
      <name>BoardLimit</name>
      <width>300</width>
      <height>331</height>
      <line_width>1</line_width>
      <line_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </line_color>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Board Number</name>
      <text>$(BOARD)</text>
      <x>1</x>
      <width>298</width>
      <height>30</height>
      <font>
        <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="led" version="2.0.0">
      <name>PMT_STAT</name>
      <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT$(PMT):HV_STATE</pv_name>
      <x>100</x>
      <y>40</y>
      <width>25</width>
      <height>25</height>
      <off_color>
        <color name="Grid" red="128" green="128" blue="128">
        </color>
      </off_color>
      <on_color>
        <color red="0" green="128" blue="0">
        </color>
      </on_color>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>PMT_STAT</name>
      <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT$(PMT):HV_STATE</pv_name>
      <x>140</x>
      <y>40</y>
      <width>60</width>
      <height>25</height>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
      <format>6</format>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="linearmeter" version="3.0.0">
      <name>Voltage</name>
      <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT$(PMT):HV_V_RBV</pv_name>
      <x>1</x>
      <y>80</y>
      <width>298</width>
      <height>100</height>
      <colors>
        <foreground_color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </foreground_color>
        <background_color>
          <color red="0" green="0" blue="0" alpha="0">
          </color>
        </background_color>
        <needle_color>
          <color red="0" green="0" blue="0">
          </color>
        </needle_color>
        <knob_color>
          <color red="0" green="0" blue="0">
          </color>
        </knob_color>
        <normal_status_color>
          <color red="194" green="198" blue="195">
          </color>
        </normal_status_color>
        <minor_warning_color>
          <color red="242" green="148" blue="141">
          </color>
        </minor_warning_color>
        <major_warning_color>
          <color red="240" green="60" blue="46">
          </color>
        </major_warning_color>
        <is_gradient_enabled>true</is_gradient_enabled>
        <is_highlighting_of_active_regions_enabled>true</is_highlighting_of_active_regions_enabled>
      </colors>
    </widget>
    <widget type="rectangle" version="2.0.0">
      <name>CountRate Area</name>
      <y>181</y>
      <width>300</width>
      <height>150</height>
      <line_width>1</line_width>
      <line_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </line_color>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
    </widget>
    <widget type="meter" version="3.0.0">
      <name>CountRate</name>
      <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT$(PMT):COUNTRATE</pv_name>
      <x>1</x>
      <y>182</y>
      <width>298</width>
      <height>148</height>
      <log_scale>true</log_scale>
      <limits_from_pv>false</limits_from_pv>
      <minimum>0.1</minimum>
      <maximum>1.0E7</maximum>
    </widget>
  </widget>
</display>
