<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <width>500</width>
  <height>800</height>
  <grid_visible>false</grid_visible>
  <widget type="rectangle" version="2.0.0">
    <name>rectLIMIT</name>
    <width>500</width>
    <height>800</height>
    <line_width>1</line_width>
    <line_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </line_color>
    <background_color>
      <color name="Background" red="255" green="255" blue="255">
      </color>
    </background_color>
  </widget>
  <widget type="label" version="2.0.0">
    <name>labeHEADER</name>
    <text>$(CHAMBER):MUSIC1:FC$(FIELD_CAGE)</text>
    <y>10</y>
    <width>500</width>
    <height>30</height>
    <font>
      <font name="Header 1" family="Liberation Sans" style="BOLD" size="22.0">
      </font>
    </font>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="bool_button" version="2.0.0">
    <name>Boolean Button</name>
    <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):HV_ENABLE</pv_name>
    <x>25</x>
    <y>50</y>
    <width>215</width>
  </widget>
  <widget type="rectangle" version="2.0.0">
    <name>rect_V_SET</name>
    <x>10</x>
    <y>100</y>
    <width>130</width>
    <height>150</height>
    <line_width>1</line_width>
    <line_color>
      <color name="Button_Background" red="210" green="210" blue="210">
      </color>
    </line_color>
    <background_color>
      <color name="Background" red="255" green="255" blue="255">
      </color>
    </background_color>
  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>Text Update</name>
    <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):HV_V_SET</pv_name>
    <x>30</x>
    <y>120</y>
    <width>90</width>
    <height>30</height>
    <background_color>
      <color name="Background" red="255" green="255" blue="255">
      </color>
    </background_color>
    <format>1</format>
    <precision>2</precision>
    <horizontal_alignment>1</horizontal_alignment>
    <vertical_alignment>1</vertical_alignment>
  </widget>
  <widget type="textentry" version="3.0.0">
    <name>Text Entry</name>
    <pv_name>loc://HVSetEdit$(CHAMBER)FC$(FIELD_CAGE)(0)</pv_name>
    <x>30</x>
    <y>160</y>
    <width>90</width>
    <height>30</height>
    <background_color>
      <color name="Background" red="255" green="255" blue="255">
      </color>
    </background_color>
    <horizontal_alignment>2</horizontal_alignment>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil

if PVUtil.getInt(pvs[2]) == 0:
    try:
        live_value = PVUtil.getDouble(pvs[0])
        pvs[1].write(live_value)
        pvs[2].write(1)
        print("Initial voltagel loaded: " + str(live_value))
    except Exception as error:
        print("INITIALIZATION ERROR: " + str(error))]]></text>
        <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):HV_V_SET</pv_name>
        <pv_name trigger="false">loc://HVSetEdit$(CHAMBER)FC$(FIELD_CAGE)(0)</pv_name>
        <pv_name trigger="false">loc://HVSetInitialized$(CHAMBER)FC$(FIELD_CAGE)(0)</pv_name>
      </script>
    </scripts>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>acbt_V_SET</name>
    <actions>
      <action type="write_pv">
        <description>Write PV</description>
        <pv_name>loc://HVSetApply$(CHAMBER)FC$(FIELD_CAGE)(0)</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>SET</text>
    <x>25</x>
    <y>200</y>
    <scripts>
      <script file="EmbeddedPy">
        <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil

if PVUtil.getInt(pvs[0]) != 0:
        try:
            requested_value = PVUtil.getDouble(pvs[1])
            print("Writing voltage: " + str(requested_value))

            pvs[2].write(requested_value)

            print("Voltage write command sent")
        except Exception as error:
            print("VOLTAGE WRITE ERROR: " + str(error))
        finally:
            pvs[0].write(0)]]></text>
        <pv_name>loc://HVSetApply$(CHAMBER)FC$(FIELD_CAGE)(0)</pv_name>
        <pv_name trigger="false">loc://HVSetEdit$(CHAMBER)FC$(FIELD_CAGE)(0)</pv_name>
        <pv_name trigger="false">SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):HV_V_SET</pv_name>
      </script>
    </scripts>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="linearmeter" version="3.0.0">
    <name>HV_V_RBV</name>
    <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):HV_V_RBV</pv_name>
    <x>150</x>
    <y>100</y>
    <width>330</width>
    <height>75</height>
    <display_mode>1</display_mode>
  </widget>
  <widget type="linearmeter" version="3.0.0">
    <name>HV_I_RBV</name>
    <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):HV_I_RBV</pv_name>
    <x>150</x>
    <y>180</y>
    <width>330</width>
    <height>75</height>
    <display_mode>1</display_mode>
    <precision>0</precision>
    <limits_from_pv>3</limits_from_pv>
    <maximum>3000.0</maximum>
  </widget>
  <widget type="group" version="3.0.0">
    <name>grup_STATUS</name>
    <x>10</x>
    <y>265</y>
    <width>480</width>
    <height>75</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="rectangle" version="2.0.0">
      <name>rectSTATE</name>
      <width>480</width>
      <height>75</height>
      <line_width>1</line_width>
      <line_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </line_color>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>labeSTATUS</name>
      <text>STATUS</text>
      <x>15</x>
      <y>10</y>
      <height>30</height>
      <font>
        <font name="Header 2" family="Liberation Sans" style="BOLD" size="18.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
    </widget>
    <widget type="byte_monitor" version="2.0.0">
      <name>bymoSTATE</name>
      <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):HV_STATE</pv_name>
      <x>150</x>
      <y>10</y>
      <width>315</width>
      <height>22</height>
      <numBits>14</numBits>
    </widget>
    <widget type="label" version="2.0.0">
      <name>labeSTATE</name>
      <text>STATE</text>
      <x>15</x>
      <y>40</y>
      <height>25</height>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="15.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>teupSTATNO</name>
      <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):HV_STATE</pv_name>
      <x>150</x>
      <y>40</y>
      <height>25</height>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>labeSTATLABEL</name>
      <text></text>
      <x>260</x>
      <y>40</y>
      <width>140</width>
      <height>25</height>
      <background_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </background_color>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="STAT_LABEL" prop_id="text" out_exp="false">
          <exp bool_exp="pv0 == 0">
            <value>CHANNEL OFF</value>
          </exp>
          <exp bool_exp="pv0 == 1">
            <value>CHANNEL ON</value>
          </exp>
          <exp bool_exp="pv0 == 3">
            <value>RAMP UP</value>
          </exp>
          <exp bool_exp="pv0 == 5">
            <value>RAMP DOWN</value>
          </exp>
          <exp bool_exp="pv0 == 7">
            <value>OVERCURRENT</value>
          </exp>
          <exp bool_exp="pv0 == 9">
            <value>OVERVOLTAGE</value>
          </exp>
          <exp bool_exp="pv0 == 11">
            <value>UNDERVOLTAGE</value>
          </exp>
          <exp bool_exp="pv0 == 13">
            <value>VMAX PROTECTION</value>
          </exp>
          <exp bool_exp="pv0 == 15">
            <value>TRIP</value>
          </exp>
          <exp bool_exp="pv0 == 17">
            <value>OVERPOWER</value>
          </exp>
          <exp bool_exp="pv0 == 19">
            <value>OVERTEMPERATURE</value>
          </exp>
          <exp bool_exp="pv0 == 21">
            <value>DISABLED</value>
          </exp>
          <exp bool_exp="pv0 == 23">
            <value>KILL</value>
          </exp>
          <exp bool_exp="pv0 == 25">
            <value>INTERLOCK</value>
          </exp>
          <exp bool_exp="pv0 == 27">
            <value>CALIBRATION ERROR</value>
          </exp>
          <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):HV_STATE</pv_name>
        </rule>
      </rules>
    </widget>
  </widget>
  <widget type="databrowser" version="2.0.0">
    <name>Data Browser</name>
    <file>FMF1_MUSIC1_FC1.plt</file>
    <x>10</x>
    <y>350</y>
    <width>480</width>
    <height>440</height>
    <selection_value_pv>SFRS:FMF1:MUSIC1:FC1:HV_V_RBV</selection_value_pv>
  </widget>
</display>
