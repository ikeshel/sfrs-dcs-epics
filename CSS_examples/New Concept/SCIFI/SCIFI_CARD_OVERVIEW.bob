  <widget type="group" version="3.0.0">
    <name>grupSCIFICARDOVERVIEW</name>
    <width>150</width>
    <height>250</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="rectangle" version="2.0.0">
      <name>rectSCIFICARD</name>
      <width>150</width>
      <height>250</height>
      <line_width>1</line_width>
      <line_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </line_color>
      <transparent>true</transparent>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lablSCIFICARD</name>
      <text>$(CHAMBER):SCIFI$(ID)</text>
      <x>2</x>
      <width>146</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>lablCOUNT_SCRIPT</name>
      <height>100</height>
      <visible>false</visible>
      <scripts>
        <script file="EmbeddedPy" check_connections="false">
          <text><![CDATA[
from org.csstudio.display.builder.runtime.script import PVUtil, ScriptUtil


def read_value(index):
    try:
        severity = PVUtil.getSeverity(pvs[index])
        if severity is None or severity >= 3:
            return None

        return PVUtil.getDouble(pvs[index])
    except:
        return None


def classify_temp(value):
    if value is None or value <= 0:
        return None

    if value >= 55:
        return "CRIT"

    if value >= 45 or value <= 5:
        return "LOW"

    return "OK"


volt_critical = 0
volt_ok = 0

temp_critical = 0
temp_low = 0
temp_ok = 0

# 16 boards, 3 PVs per board:
# FPGA temperature, SiPM bias state, SiPM temperature
for board in range(16):
    base = board * 3

    # Voltage / bias state
    bias = read_value(base + 1)

    if bias == 2:
        volt_critical += 1
    elif bias == 1:
        volt_ok += 1
    # State 0 and invalid values are excluded.

    # Temperature: FPGA and SiPM
    fpga_temp = classify_temp(read_value(base))
    sipm_temp = classify_temp(read_value(base + 2))

    states = [fpga_temp, sipm_temp]

    # Critical has priority over Low.
    if "CRIT" in states:
        temp_critical += 1
    elif "LOW" in states:
        temp_low += 1
    elif fpga_temp == "OK" and sipm_temp == "OK":
        temp_ok += 1
    # Invalid or disconnected readings cannot produce OK.


def update_label(name, value):
    target = ScriptUtil.findWidgetByName(widget, name)

    if target is not None:
        target.setPropertyValue("text", str(value))
    else:
        print("Count label not found: " + name)


update_label("lablVOLTCRIT", volt_critical)
update_label("lablVOLTLOW", 0)
update_label("lablVOLTOK", volt_ok)

update_label("lablTEMPCRIT", temp_critical)
update_label("lablTEMPLOW", temp_low)
update_label("lablTEMPOK", temp_ok)]]></text>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV0:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV0:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV0:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV1:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV1:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV1:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV2:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV2:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV2:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV3:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV3:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV3:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV4:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV4:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV4:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV5:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV5:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP0:DEV5:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP1:DEV0:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP1:DEV0:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP1:DEV0:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP1:DEV1:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP1:DEV1:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP1:DEV1:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV0:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV0:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV0:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV1:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV1:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV1:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV2:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV2:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV2:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV3:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV3:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV3:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV4:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV4:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV4:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV5:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV5:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP2:DEV5:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP3:DEV0:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP3:DEV0:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP3:DEV0:SIPM:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP3:DEV1:FPGA:TEMP</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP3:DEV1:SIPM:BIAS_STATE</pv_name>
          <pv_name>SFRS:$(CHAMBER):SCIFI$(ID):SFP3:DEV1:SIPM:TEMP</pv_name>
        </script>
      </scripts>
    </widget>
    <widget type="group" version="3.0.0">
