    <widget type="group" version="3.0.0">
      <name>grupDETAILS</name>
      <x>2</x>
      <y>180</y>
      <width>139</width>
      <height>62</height>
      <style>3</style>
      <transparent>true</transparent>
      <widget type="label" version="2.0.0">
        <name>lablSCIFIDETAILS</name>
        <text>Details</text>
        <width>50</width>
        <font>
          <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
          </font>
        </font>
      </widget>
      <widget type="label" version="2.0.0">
        <name>lablDESCRIPTION</name>
        <text>For details click the button</text>
        <x>59</x>
        <y>2</y>
        <width>80</width>
        <height>60</height>
        <horizontal_alignment>1</horizontal_alignment>
      </widget>
      <widget type="action_button" version="3.0.0">
        <name>acbtSCIFIDETAILS</name>
        <actions>
          <action type="open_display">
            <description>Open Display</description>
            <file>BoardTemplate_SCIFI.bob</file>
            <target>tab</target>
          </action>
        </actions>
        <text>Details</text>
        <y>30</y>
        <width>55</width>
        <tooltip>$(actions)</tooltip>
      </widget>
    </widget>
  </widget>
</display>
