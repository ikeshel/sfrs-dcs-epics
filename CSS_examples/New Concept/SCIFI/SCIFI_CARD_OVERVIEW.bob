      <widget type="label" version="2.0.0">
        <name>lablSTATUSCRIT</name>
        <text>Critical</text>
        <x>2</x>
        <y>65</y>
        <width>44</width>
        <vertical_alignment>1</vertical_alignment>
        <rules>
          <rule name="CriticalRed" prop_id="foreground_color" out_exp="false">
            <exp bool_exp="true">
              <value>
                <color name="MAJOR" red="255" green="0" blue="0">
                </color>
              </value>
            </exp>
            <pv_name>loc://critical_color_test(1)</pv_name>
          </rule>
        </rules>
      </widget>
