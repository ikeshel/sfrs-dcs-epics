      </widget>
      <widget type="label" version="2.0.0">
        <name>lablHV_STATUS_VALUE</name>
        <text>Label</text>
        <x>55</x>
        <y>70</y>
        <width>90</width>
        <height>40</height>
        <horizontal_alignment>1</horizontal_alignment>
        <vertical_alignment>1</vertical_alignment>
        <scripts>
          <script file="EmbeddedPy" check_connections="false">
            <text><![CDATA[
from org.csstudio.display.builder.runtime.script import PVUtil

on_count = 0
warning_count = 0
off_count = 0
unavailable_count = 0

for i in range(6):
    try:
        rbv = PVUtil.getDouble(pvs[i])
        setpoint = PVUtil.getDouble(pvs[i + 6])
        state = PVUtil.getDouble(pvs[i + 12])

        if state == 0:
            off_count += 1
        elif state == 1:
            on_count += 1

            if abs(rbv - setpoint) > 0.01:
                warning_count += 1
        else:
            unavailable_count += 1

    except:
        unavailable_count += 1

if unavailable_count > 0:
    status = "DISCONNECTED"
elif warning_count > 0:
    status = "WARNING"
elif on_count == 0:
    status = "OFF"
else:
    status = "OK"

widget.setPropertyValue("text", status)]]></text>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT01:HV_V_RBV</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT02:HV_V_RBV</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT03:HV_V_RBV</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT04:HV_V_RBV</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT05:HV_V_RBV</pv_name>
