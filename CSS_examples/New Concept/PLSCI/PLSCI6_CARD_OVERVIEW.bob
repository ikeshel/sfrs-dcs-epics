      <widget type="label" version="2.0.0">
        <name>lablCOUNTRATE</name>
        <text>Countrate</text>
        <y>115</y>
        <width>50</width>
        <height>40</height>
        <horizontal_alignment>1</horizontal_alignment>
        <vertical_alignment>1</vertical_alignment>
      </widget>
      <widget type="label" version="2.0.0">
        <name>lablTOTAL_COUNTRATE</name>
        <text>Label</text>
        <x>55</x>
        <y>115</y>
        <width>90</width>
        <height>40</height>
        <horizontal_alignment>1</horizontal_alignment>
        <vertical_alignment>1</vertical_alignment>
        <scripts>
          <script file="EmbeddedPy" check_connections="false">
            <text><![CDATA[
from org.csstudio.display.builder.runtime.script import PVUtil
from java.lang import Double

total_rate = 0.0
valid_count = 0

for pv in pvs:
    try:
        value = PVUtil.getDouble(pv)

        if not Double.isNaN(value) and not Double.isInfinite(value):
            total_rate += value
            valid_count += 1

    except:
        pass

if valid_count == 6:
    widget.setPropertyValue(
        "text", "{:.0f} Hz".format(total_rate)
    )
else:
    widget.setPropertyValue(
        "text", "DISCONNECTED"
    )]]></text>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT01:COUNTRATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT02:COUNTRATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT03:COUNTRATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT04:COUNTRATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT05:COUNTRATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT06:COUNTRATE</pv_name>
          </script>
        </scripts>
