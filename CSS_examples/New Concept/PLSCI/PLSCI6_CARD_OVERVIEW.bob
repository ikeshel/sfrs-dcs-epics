            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT05:HV_V_SET</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT06:HV_V_SET</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT01:HV_STATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT02:HV_STATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT03:HV_STATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT04:HV_STATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT05:HV_STATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT06:HV_STATE</pv_name>
          </script>
