        <scripts>
          <script file="EmbeddedPy" check_connections="false">
            <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil

on_count = 0

for pv in pvs:
    try:
        value = PVUtil.getDouble(pv)
        if value == 1:
            on_count += 1
    except:
        pass

widget.setPropertyValue("text", str(on_count) + " / 6")]]></text>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT01:HV_STATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT02:HV_STATE</pv_name>
            <pv_name>SFRS:$(CHAMBER):PLSCI1:PMT03:HV_STATE</pv_name>
