    <x>10</x>
    <y>294</y>
    <width>480</width>
    <height>374</height>
    <scripts>
      <script file="EmbeddedPy" check_connections="false">
        <text><![CDATA[# NHV plot: fixed full operating ranges; PHV keeps its existing file.
if '$(CHANNEL)' in ('NHV', 'NEGATIVE'):
    widget.setPropertyValue('file', 'MUSIC_NHV.plt')
]]></text>
      </script>
    </scripts>
    <selection_value_pv>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):$(CHANNEL):V_RBV</selection_value_pv>
