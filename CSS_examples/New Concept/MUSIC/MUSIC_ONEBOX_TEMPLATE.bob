    <widget type="textupdate" version="2.0.0">
      <name>teupHV_400V_SET</name>
      <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):$(CHANNEL):V_SET</pv_name>
      <x>20</x>
      <y>14</y>
      <width>90</width>
      <height>21</height>
      <visible>false</visible>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
      <format>1</format>
      <precision>2</precision>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="textentry" version="3.0.0">
      <name>teenHV_400V_SET</name>
      <pv_name>loc://HVSetEdit$(CHAMBER)FC$(FIELD_CAGE)$(CHANNEL)(0)</pv_name>
      <x>15</x>
      <y>100</y>
      <width>90</width>
      <height>21</height>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
      <horizontal_alignment>1</horizontal_alignment>
      <scripts>
        <script file="EmbeddedPy">
          <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil

if PVUtil.getInt(pvs[2]) == 0:
    try:
        live_value = PVUtil.getDouble(pvs[0])
        pvs[1].write(live_value)
        pvs[2].write(1)
        print("Initial voltage loaded: " + str(live_value))
    except Exception as error:
        print("INITIALIZATION ERROR: " + str(error))]]></text>
          <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):$(CHANNEL):V_SET</pv_name>
          <pv_name trigger="false">loc://HVSetEdit$(CHAMBER)FC$(FIELD_CAGE)$(CHANNEL)(0)</pv_name>
          <pv_name trigger="false">loc://HVSetInitialized$(CHAMBER)FC$(FIELD_CAGE)$(CHANNEL)(0)</pv_name>
        </script>
      </scripts>
    </widget>
    <widget type="action_button" version="3.0.0">
      <name>acbt400V_SET</name>
      <actions>
        <action type="write_pv">
          <description>Write PV</description>
          <pv_name>loc://HVSetApply$(CHAMBER)FC$(FIELD_CAGE)$(CHANNEL)(0)</pv_name>
          <value>1</value>
        </action>
      </actions>
      <text>V_SET</text>
      <x>15</x>
      <y>58</y>
      <scripts>
        <script file="EmbeddedPy">
          <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil

if PVUtil.getInt(pvs[0]) != 0:
        try:
            requested_value = PVUtil.getDouble(pvs[1])
            print("Writing voltage: " + str(requested_value))

            pvs[2].write(requested_value)

            print("Voltage write command sent")
        except Exception as error:
            print("VOLTAGE WRITE ERROR: " + str(error))
        finally:
            pvs[0].write(0)]]></text>
          <pv_name>loc://HVSetApply$(CHAMBER)FC$(FIELD_CAGE)$(CHANNEL)(0)</pv_name>
          <pv_name trigger="false">loc://HVSetEdit$(CHAMBER)FC$(FIELD_CAGE)$(CHANNEL)(0)</pv_name>
          <pv_name trigger="false">SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):$(CHANNEL):V_SET</pv_name>
        </script>
      </scripts>
      <tooltip>$(actions)</tooltip>
      <show_confirm_dialog>true</show_confirm_dialog>
    </widget>
    <widget type="linearmeter" version="3.0.0">
      <name>limeHV_V_RBV</name>
      <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):$(CHANNEL):V_RBV</pv_name>
      <x>140</x>
      <width>330</width>
      <height>75</height>
      <display_mode>1</display_mode>
      <show_units>false</show_units>
      <scripts>
        <script file="EmbeddedPy" check_connections="false">
          <text><![CDATA[# NHV display limits: visual guides only, not EPICS alarms.
if '$(CHANNEL)' in ('NHV', 'NEGATIVE'):
    # Mode 1 takes display min/max from the PV, levels from this widget.
    widget.setPropertyValue('limits_from_pv', 1)
    widget.setPropertyValue('level_lolo', -1.0)
    widget.setPropertyValue('level_low', -1.0)
    widget.setPropertyValue('level_high', 4250.0)
    widget.setPropertyValue('level_hihi', 4500.0)
]]></text>
        </script>
      </scripts>
      <minimum></minimum>
      <maximum></maximum>
      <level_lolo></level_lolo>
      <level_low></level_low>
      <level_high></level_high>
      <level_hihi></level_hihi>
      <min_max_tolerance></min_max_tolerance>
    </widget>
