    <widget type="action_button" version="3.0.0">
      <name>acbtSTATUS_HELP</name>
      <actions>
        <action type="open_display">
          <description>opdiINFO_BOX</description>
          <file>MUISC_Status_Information_Box.bob</file>
          <target>window</target>
        </action>
      </actions>
      <text>INFO</text>
      <x>15</x>
      <y>28</y>
      <height>36</height>
      <tooltip>$(actions)</tooltip>
    </widget>
    <widget type="label" version="2.0.0">
      <name>labeSTAT_LABEL</name>
      <text></text>
      <x>184</x>
      <y>38</y>
      <width>194</width>
      <height>18</height>
      <background_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </background_color>
      <vertical_alignment>1</vertical_alignment>
      <scripts>
        <script file="EmbeddedPy">
          <text><![CDATA[from org.csstudio.display.builder.runtime.script import PVUtil

state = PVUtil.getInt(pvs[0])

bit_names = [
    "Channel ON",
    "Ramp up",
    "Ramp down",
    "Overcurrent",
    "Overvoltage",
    "Undervoltage",
    "VMAX protection",
    "Trip",
    "Overpower",
    "Overtemperature",
    "Disabled",
    "Kill",
    "Interlock",
    "Calibration error"
]

active_states = []

for bit in range(len(bit_names)):
    if (state & (1 << bit)) != 0:
        active_states.append(bit_names[bit])

if len(active_states) == 0:
    text = "Channel OFF"
else:
    text = " | ".join(active_states)

widget.setPropertyValue("text", text)

print("HV_STATE=" + str(state) + " -> " + text)]]></text>
          <pv_name>SFRS:$(CHAMBER):MUSIC1:FC$(FIELD_CAGE):$(CHANNEL):STATUS</pv_name>
        </script>
      </scripts>
    </widget>
  </widget>
  <widget type="databrowser" version="2.0.0">
