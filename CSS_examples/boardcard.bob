<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <width>200</width>
  <height>250</height>
  <grid_visible>false</grid_visible>
  <widget type="group" version="3.0.0">
    <name>Board</name>
    <width>200</width>
    <height>250</height>
    <style>3</style>
    <transparent>true</transparent>
    <widget type="rectangle" version="2.0.0">
      <name>Board</name>
      <width>200</width>
      <height>250</height>
      <line_width>1</line_width>
      <line_color>
        <color name="Button_Background" red="210" green="210" blue="210">
        </color>
      </line_color>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Board Number</name>
      <text>$(BOARD)</text>
      <width>200</width>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Board Description</name>
      <text>SFP $(SFP), DEV $(DEV)</text>
      <x>20</x>
      <y>25</y>
      <width>180</width>
      <font>
        <font family="Liberation Sans" style="REGULAR" size="12.0">
        </font>
      </font>
    </widget>
    <widget type="label" version="2.0.0">
      <name>FPGA</name>
      <text>FPGA</text>
      <x>25</x>
      <y>45</y>
      <width>50</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="thermometer" version="2.0.0">
      <name>FPGA Thermometer</name>
      <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):FPGA:TEMP</pv_name>
      <x>35</x>
      <y>70</y>
      <width>30</width>
      <height>75</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>FPGA Value</name>
      <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):FPGA:TEMP</pv_name>
      <x>10</x>
      <y>150</y>
      <width>80</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
      <format>1</format>
      <precision>1</precision>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>SiPM</name>
      <text>SiPM</text>
      <x>125</x>
      <y>45</y>
      <width>50</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="thermometer" version="2.0.0">
      <name>SiPM Thermometer</name>
      <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:TEMP</pv_name>
      <x>135</x>
      <y>70</y>
      <width>30</width>
      <height>75</height>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>SIPM Value</name>
      <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:TEMP</pv_name>
      <x>110</x>
      <y>150</y>
      <width>80</width>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
      <format>1</format>
      <precision>1</precision>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Bias Title</name>
      <text>Bias Set | RBV</text>
      <x>10</x>
      <y>185</y>
      <font>
        <font name="Default Bold" family="Liberation Sans" style="BOLD" size="14.0">
        </font>
      </font>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Bias Set</name>
      <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:BIAS_SET</pv_name>
      <x>10</x>
      <y>215</y>
      <width>50</width>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
      <format>1</format>
      <precision>1</precision>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="Volt_Diff" prop_id="foreground_color" out_exp="false">
          <exp bool_exp="Math.abs(pv0-pv1) &gt; 0.6">
            <value>
              <color name="STOP" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="Math.abs(pv0 - pv1) &lt;= 0.6">
            <value>
              <color red="0" green="128" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:BIAS_SET</pv_name>
          <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:BIAS_RBV</pv_name>
        </rule>
      </rules>
    </widget>
    <widget type="label" version="2.0.0">
      <name>Bias Set and Bias RBV</name>
      <text>|</text>
      <x>68</x>
      <y>215</y>
      <width>10</width>
      <horizontal_alignment>1</horizontal_alignment>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="Volt_Diff" prop_id="foreground_color" out_exp="false">
          <exp bool_exp="Math.abs(pv0 - pv1) &gt; 0.6">
            <value>
              <color name="STOP" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="Math.abs(pv0 - pv1) &lt;= 0.6">
            <value>
              <color red="0" green="128" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:BIAS_SET</pv_name>
          <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:BIAS_RBV</pv_name>
        </rule>
      </rules>
    </widget>
    <widget type="textupdate" version="2.0.0">
      <name>Bias RBV</name>
      <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:BIAS_RBV</pv_name>
      <x>80</x>
      <y>215</y>
      <width>50</width>
      <background_color>
        <color name="Background" red="255" green="255" blue="255">
        </color>
      </background_color>
      <format>1</format>
      <precision>1</precision>
      <vertical_alignment>1</vertical_alignment>
      <rules>
        <rule name="Volt_Diff" prop_id="foreground_color" out_exp="false">
          <exp bool_exp="Math.abs(pv0 - pv1) &gt; 0.6">
            <value>
              <color name="STOP" red="255" green="0" blue="0">
              </color>
            </value>
          </exp>
          <exp bool_exp="Math.abs(pv0 - pv1) &lt;= 0.6">
            <value>
              <color red="0" green="128" blue="0">
              </color>
            </value>
          </exp>
          <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:BIAS_SET</pv_name>
          <pv_name>SFRS:$(CHAMBER_NAME):$(DETECTOR):SFP$(SFP):DEV$(DEV):SIPM:BIAS_RBV</pv_name>
        </rule>
      </rules>
    </widget>
  </widget>
</display>
