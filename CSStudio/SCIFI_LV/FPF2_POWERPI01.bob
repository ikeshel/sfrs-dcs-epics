      <pv_name>jackie://SFRS:FPF2:POWERPI01:ENABLE:CH15</pv_name>
      <enabled>false</enabled>
      <tooltip>Front-panel button S16
$(pv_name)
$(pv_value)</tooltip>
      <bit>0</bit>
      <mode>0</mode>
      <labels_from_pv>false</labels_from_pv>
      <show_led>false</show_led>
      <off_label>OFF CH 15</off_label>
      <on_label>ON CH 15</on_label>
      <off_color>
        <color red="179" green="58" blue="69" />
      </off_color>
      <on_color>
        <color red="245" green="204" blue="80" />
      </on_color>
      <foreground_color>
        <color red="0" green="0" blue="0" />
      </foreground_color>
      <font>
        <font family="Liberation Sans" size="20.0" style="BOLD" />
      </font>
      <scripts>
        <script file="EmbeddedPy" check_connections="false">
          <text>from org.csstudio.display.builder.runtime.script import ValueUtil
from org.epics.vtype import Alarm, AlarmSeverity, VNumber
from org.phoebus.pv import PV
from org.phoebus.ui.color import WidgetColor

readback = pvs[0].read()
confirmed = (not PV.isDisconnected(readback) and isinstance(readback, VNumber)
             and Alarm.alarmOf(readback).getSeverity() == AlarmSeverity.NONE
             and ValueUtil.getDouble(readback) == 1.0)
flash_rgb = (240, 244, 248) if ValueUtil.getDouble(pvs[1].read()) == 1.0 else (245, 204, 80)
flash = WidgetColor(*flash_rgb)
# The button selects the current fill from its writable ENABLE PV.
widget.propOnColor().setValue(WidgetColor(*(133, 222, 151)) if confirmed else flash)
widget.propOffColor().setValue(flash if confirmed else WidgetColor(*(179, 58, 69)))
</text>
          <pv_name>jackie://SFRS:FPF2:POWERPI01:ENABLE_RBV:CH15</pv_name>
          <pv_name>sim://ramp(0,1,0.5)</pv_name>
        </script>
      </scripts>
    </widget>
  </widget>
