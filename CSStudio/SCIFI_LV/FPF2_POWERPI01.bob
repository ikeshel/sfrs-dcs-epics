    <widget type="action_button" version="3.0.0">
      <name>Row CH12–CH15 toggle</name>
      <x>16</x>
      <y>58</y>
      <width>153</width>
      <height>57</height>
      <text>UNAVAILABLE</text>
      <font>
        <font family="Liberation Sans" size="20.0" style="BOLD" />
      </font>
      <foreground_color>
        <color red="255" green="255" blue="255" />
      </foreground_color>
      <background_color>
        <color red="31" green="49" blue="67" />
      </background_color>
      <enabled>false</enabled>
      <tooltip>Toggle CH12–CH15. Turns all off when all are on, otherwise turns all on. Only OFF commands are available during a thermal trip or while trip status is unavailable.</tooltip>
      <scripts>
        <script file="EmbeddedPy" check_connections="false">
          <text>from org.csstudio.display.builder.runtime.script import ValueUtil
from org.epics.vtype import Alarm, VNumber
from org.phoebus.pv import PV

def verified(value):
    return not PV.isDisconnected(value) and Alarm.alarmOf(value).getSeverity().ordinal() &lt; 3

def trip_mask(value):
    return ValueUtil.getLong(value) if isinstance(value, VNumber) and verified(value) else None

def channel_pvs(pvs):
    return [pv for pv in pvs if pv.getName().startswith('jackie://SFRS:FPF2:POWERPI01:ENABLE:CH')]

def thermal_clear(pvs):
    trips = next((pv for pv in pvs if pv.getName() == '=highestSeverity(`jackie://SFRS:FPF2:POWERPI01:TEMPERATURE:TRIPS`) &gt;= 3 ? -1 : `jackie://SFRS:FPF2:POWERPI01:TEMPERATURE:TRIPS`'), None)
    return trips is not None and trip_mask(trips.read()) == 0

def writable_channels(channels):
    return [pv for pv in channels if not PV.isDisconnected(pv.read()) and not pv.isReadonly()]

def row_action(inputs):
    channels = channel_pvs(inputs)
    writable = writable_channels(channels)
    if not thermal_clear(inputs):
        return writable, 0
    if len(writable) != 4:
        return [], 0
    target = 0 if all(ValueUtil.getInt(pv.read()) == 1 for pv in channels) else 1
    return channels, target

channels, target = row_action(pvs)
widget.propText().setValue(('ALL ON' if target else 'ALL OFF') if channels else 'UNAVAILABLE')
widget.propEnabled().setValue(bool(channels))
</text>
          <pv_name>jackie://SFRS:FPF2:POWERPI01:ENABLE:CH12</pv_name>
          <pv_name>jackie://SFRS:FPF2:POWERPI01:ENABLE:CH13</pv_name>
          <pv_name>jackie://SFRS:FPF2:POWERPI01:ENABLE:CH14</pv_name>
          <pv_name>jackie://SFRS:FPF2:POWERPI01:ENABLE:CH15</pv_name>
          <pv_name>=highestSeverity(`jackie://SFRS:FPF2:POWERPI01:TEMPERATURE:TRIPS`) &gt;= 3 ? -1 : `jackie://SFRS:FPF2:POWERPI01:TEMPERATURE:TRIPS`</pv_name>
          <pv_name>sys://time</pv_name>
        </script>
      </scripts>
      <actions>
        <action type="execute">
          <description>Toggle CH12–CH15</description>
          <script file="EmbeddedPy">
            <text>from org.csstudio.display.builder.runtime.script import ValueUtil
from org.epics.vtype import Alarm, VNumber
from org.phoebus.pv import PV

def verified(value):
    return not PV.isDisconnected(value) and Alarm.alarmOf(value).getSeverity().ordinal() &lt; 3

def trip_mask(value):
    return ValueUtil.getLong(value) if isinstance(value, VNumber) and verified(value) else None

def channel_pvs(pvs):
    return [pv for pv in pvs if pv.getName().startswith('jackie://SFRS:FPF2:POWERPI01:ENABLE:CH')]

def thermal_clear(pvs):
    trips = next((pv for pv in pvs if pv.getName() == '=highestSeverity(`jackie://SFRS:FPF2:POWERPI01:TEMPERATURE:TRIPS`) &gt;= 3 ? -1 : `jackie://SFRS:FPF2:POWERPI01:TEMPERATURE:TRIPS`'), None)
    return trips is not None and trip_mask(trips.read()) == 0

def writable_channels(channels):
    return [pv for pv in channels if not PV.isDisconnected(pv.read()) and not pv.isReadonly()]

def row_action(inputs):
    channels = channel_pvs(inputs)
    writable = writable_channels(channels)
    if not thermal_clear(inputs):
        return writable, 0
    if len(writable) != 4:
        return [], 0
    target = 0 if all(ValueUtil.getInt(pv.read()) == 1 for pv in channels) else 1
    return channels, target
from java.lang import Exception as JavaException
from org.csstudio.display.builder.runtime.script import ScriptUtil

channels, target = row_action(ScriptUtil.getPVs(widget))
if channels:
    failed = []
    for pv in channels:
        try:
            pv.write(target)
        except JavaException:
            failed.append(pv.getName())
    if failed:
        ScriptUtil.showErrorDialog(widget, 'Could not write: ' + ', '.join(failed))
else:
    ScriptUtil.showErrorDialog(widget, 'Row controls are unavailable. Check the channel PV connections.')
</text>
          </script>
        </action>
      </actions>
    </widget>
