  <widget type="action_button" version="3.0.0">
    <name>Start control</name>
    <actions>
      <action type="write_pv">
        <description>Start temperature control</description>
        <pv_name>$(P)RUN</pv_name>
        <value>1</value>
      </action>
    </actions>
    <text>Start</text>
    <x>415</x>
    <y>382</y>
    <width>94</width>
    <height>38</height>
    <tooltip>$(actions)</tooltip>
  </widget>
  <widget type="action_button" version="3.0.0">
    <name>Stop control</name>
    <actions>
      <action type="write_pv">
        <description>Stop temperature control</description>
        <pv_name>$(P)RUN</pv_name>
        <value>0</value>
      </action>
    </actions>
    <text>Stop</text>
    <x>519</x>
    <y>382</y>
    <width>94</width>
    <height>38</height>
    <tooltip>$(actions)</tooltip>
