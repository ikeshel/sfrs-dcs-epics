  </widget>
  <widget type="textupdate" version="2.0.0">
    <name>External</name>
    <pv_name>$(P)TEMP_EXTERNAL_RBV</pv_name>
    <x>448</x>
    <y>187</y>
    <width>185</width>
    <height>40</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="25.0">
      </font>
    </font>
    <precision>2</precision>
    <rules>
      <rule name="Dim absent external sensor" prop_id="foreground_color" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>
            <color red="150" green="150" blue="150">
            </color>
          </value>
        </exp>
        <pv_name>$(P)EXTERNAL_SENSOR_PRESENT</pv_name>
      </rule>
      <rule name="Inactive external sensor background" prop_id="background_color" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>
            <color red="235" green="235" blue="235">
            </color>
          </value>
        </exp>
        <pv_name>$(P)EXTERNAL_SENSOR_PRESENT</pv_name>
      </rule>
      <rule name="Suppress absent sensor alarm border" prop_id="border_alarm_sensitive" out_exp="false">
        <exp bool_exp="pv0 == 0">
          <value>false</value>
        </exp>
        <pv_name>$(P)EXTERNAL_SENSOR_PRESENT</pv_name>
      </rule>
    </rules>
  </widget>
