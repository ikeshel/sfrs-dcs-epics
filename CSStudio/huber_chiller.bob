    <name>Trend heading</name>
    <x>44</x>
    <y>497</y>
    <width>650</width>
    <height>24</height>
    <text>LIVE TEMPERATURE TREND</text>
    <font>
      <font family="Liberation Sans" style="BOLD" size="14" />
    </font>
    <foreground_color>
      <color red="31" green="49" blue="67" />
    </foreground_color>
  </widget>
  <widget type="stripchart" version="2.1.0">
    <name>Temperature trend</name>
    <x>34</x>
    <y>529</y>
    <width>932</width>
    <height>215</height>
    <show_toolbar>true</show_toolbar>
    <show_legend>true</show_legend>
    <y_axes>
      <y_axis>
        <title>Temperature (°C)</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>-20</minimum>
        <maximum>40</maximum>
        <show_grid>true</show_grid>
        <visible>true</visible>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>Internal</name>
        <y_pv>$(P)TEMP_RBV</y_pv>
        <axis>0</axis>
        <trace_type>6</trace_type>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>1</point_size>
        <visible>true</visible>
        <color>
          <color red="32" green="115" blue="190" />
        </color>
      </trace>
      <trace>
        <name>Device setpoint</name>
        <y_pv>$(P)TEMP_SET_RBV</y_pv>
        <axis>0</axis>
        <trace_type>6</trace_type>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>1</point_size>
        <visible>true</visible>
        <color>
          <color red="218" green="125" blue="35" />
        </color>
      </trace>
    </traces>
  </widget>
  <widget type="label" version="2.0.0">
    <name>Footer</name>
    <x>24</x>
    <y>764</y>
    <width>952</width>
    <height>20</height>
    <text>Readbacks poll every 2 s; identity every 10 s. Trend collects while this display is open.</text>
    <font>
