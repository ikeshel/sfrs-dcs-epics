<?xml version="1.0" encoding="UTF-8"?>
<display version="2.0.0">
  <name>Huber Unichiller</name>
  <macros>
    <P>SFRS:FHF1:SCIFI3:CHILLER:</P>
  </macros>
  <width>1000</width>
  <height>1005</height>
  <background_color>
    <color red="240" green="244" blue="248">
    </color>
  </background_color>
  <grid_visible>false</grid_visible>
  <widget type="label" version="2.0.0">
    <name>Title</name>
    <text>HUBER  /  Unichiller P012 OLE</text>
    <x>24</x>
    <y>18</y>
    <width>650</width>
    <height>38</height>
    <font>
      <font family="Liberation Sans" style="BOLD" size="27.0">
      </font>
    </font>
    <foreground_color>
      <color red="31" green="49" blue="67">
      </color>
    </foreground_color>
  </widget>
