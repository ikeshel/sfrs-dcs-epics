  <widget type="stripchart" version="2.1.0">
    <name>Temperature trend</name>
    <x>44</x>
    <y>481</y>
    <width>1202</width>
    <height>469</height>
    <show_toolbar>false</show_toolbar>
    <show_legend>true</show_legend>
    <start>60 minute</start>
    <y_axes>
      <y_axis>
        <title>Temperature (°C)</title>
        <autoscale>true</autoscale>
        <log_scale>false</log_scale>
        <minimum>-20.0</minimum>
        <maximum>40.0</maximum>
        <show_grid>true</show_grid>
        <visible>true</visible>
        <color>
          <color name="Text" red="0" green="0" blue="0">
          </color>
        </color>
      </y_axis>
    </y_axes>
    <traces>
      <trace>
        <name>Internal</name>
        <y_pv>$(P)TEMP_RBV</y_pv>
        <axis>0</axis>
        <trace_type>6</trace_type>
        <color>
          <color red="32" green="115" blue="190">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>1</point_size>
        <visible>true</visible>
      </trace>
      <trace>
        <name>Device setpoint</name>
        <y_pv>$(P)TEMP_SET_RBV</y_pv>
        <axis>0</axis>
        <trace_type>6</trace_type>
        <color>
          <color red="218" green="125" blue="35">
          </color>
        </color>
        <line_width>2</line_width>
        <point_type>0</point_type>
        <point_size>1</point_size>
        <visible>true</visible>
      </trace>
    </traces>
  </widget>
