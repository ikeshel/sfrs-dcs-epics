###############################################################################
#
# Generic Plastic Scintillator PMT record
#
# Plastic scintillator PMT template
#     plsci.substitutions
# PMT should be zero-padded from 01 through 08.
#
# Authors: i.keshelashvili@gsi.de
#
###############################################################################

record(ao, "SFRS:$(CHAMBER):PLSCI1:PMT$(PMT):THR")
{
    field(DESC, "$(CHAMBER) PLSCI1 PMT$(PMT) threshold")
    field(DTYP, "Soft Channel")
    field(EGU,  "$(THR_EGU=raw)")
    field(PREC, "$(THR_PREC=0)")
    field(LOPR, "$(THR_MIN=0)")
    field(HOPR, "$(THR_MAX=65535)")
    field(DRVL, "$(THR_MIN=0)")
    field(DRVH, "$(THR_MAX=65535)")
}

record(ao, "SFRS:$(CHAMBER):PLSCI1:PMT$(PMT):HV_SET")
{
    field(DESC, "$(CHAMBER) PLSCI1 PMT$(PMT) HV setpoint")
    field(DTYP, "Soft Channel")
    field(EGU,  "V")
    field(PREC, "3")
    field(LOPR, "0")
    field(HOPR, "1")
    field(DRVL, "0")
    field(DRVH, "1")
}

record(ao, "SFRS:$(CHAMBER):PLSCI1:PMT$(PMT):HV_RBV")
{
    field(DESC, "$(CHAMBER) PLSCI1 PMT$(PMT) HV readback")
    field(DTYP, "Soft Channel")
    field(EGU,  "V")
    field(PREC, "3")
    field(LOPR, "0")
    field(HOPR, "1")
    field(DRVL, "0")
    field(DRVH, "1")
}

record(bo, "SFRS:$(CHAMBER):PLSCI1:PMT$(PMT):STAT")
{
    field(DESC, "$(CHAMBER) PLSCI1 PMT$(PMT) status")
    field(DTYP, "Soft Channel")
    field(ZNAM, "OFF")
    field(ONAM, "ON")
}
