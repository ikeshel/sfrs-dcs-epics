###############################################################################
#
# MUSIC field-cage high-voltage records
#
# Macros:
#     CHAMBER       Beamline chamber, for example FMF1 or FHF1
#     MUSIC         MUSIC detector number, for example 1
#     FIELD_CAGE    Field-cage number, for example 1, 2 or 3
#
# Authors:
#     i.keshelashvili@gsi.de
#
###############################################################################

#
# Requested high voltage
# CAEN parameter: VSET
#
record(ao, "SFRS:$(CHAMBER):MUSIC$(DETECTOR):FC$(FIELD_CAGE):HV_V_SET")
{
    field(DESC, "$(CHAMBER) MUSIC$(DETECTOR) FC$(FIELD_CAGE) voltage setpoint")
    field(DTYP, "Soft Channel")
    field(SCAN, "Passive")

    field(EGU,  "V")
    field(PREC, "1")

    # Use detector-safe limits, not merely the power-supply limits.
    field(DRVL, "0")
    field(DRVH, "3000")
    field(LOPR, "0")
    field(HOPR, "3000")

    field(PINI, "NO")
}

#
# Measured high voltage
# CAEN parameter: VMON
#
record(ai, "SFRS:$(CHAMBER):MUSIC$(DETECTOR):FC$(FIELD_CAGE):HV_V_RBV")
{
    field(DESC, "$(CHAMBER) MUSIC$(DETECTOR) FC$(FIELD_CAGE) voltage readback")
    field(DTYP, "Soft Channel")
    field(SCAN, "Passive")

    field(EGU,  "V")
    field(PREC, "1")

    field(LOPR, "0")
    field(HOPR, "3000")

    field(MDEL, "0.2")
    field(ADEL, "0.2")
}

#
# Requested current limit
# CAEN parameter: ISET
#
record(ao, "SFRS:$(CHAMBER):MUSIC$(DETECTOR):FC$(FIELD_CAGE):HV_I_SET")
{
    field(DESC, "$(CHAMBER) MUSIC$(DETECTOR) FC$(FIELD_CAGE) current limit")
    field(DTYP, "Soft Channel")
    field(SCAN, "Passive")

    field(EGU,  "uA")
    field(PREC, "3")

    # Replace with the detector-safe current limit.
    field(DRVL, "0")
    field(DRVH, "3000")
    field(LOPR, "0")
    field(HOPR, "3000")

    field(PINI, "NO")
}

#
# Measured high-voltage current
# CAEN parameter: IMON
#
record(ai, "SFRS:$(CHAMBER):MUSIC$(DETECTOR):FC$(FIELD_CAGE):HV_I_RBV")
{
    field(DESC, "$(CHAMBER) MUSIC$(DETECTOR) FC$(FIELD_CAGE) current readback")
    field(DTYP, "Soft Channel")
    field(SCAN, "Passive")

    field(EGU,  "uA")
    field(PREC, "3")

    field(LOPR, "0")
    field(HOPR, "3000")

    field(MDEL, "0.005")
    field(ADEL, "0.005")
}

#
# Raw CAEN channel-status bitmask
# CAEN parameter: STAT
#
record(longin, "SFRS:$(CHAMBER):MUSIC$(DETECTOR):FC$(FIELD_CAGE):HV_STAT")
{
    field(DESC, "$(CHAMBER) MUSIC$(DETECTOR) FC$(FIELD_CAGE) raw HV status")
    field(DTYP, "Soft Channel")
    field(SCAN, "Passive")
}